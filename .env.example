# 本地开发配置。生产环境请使用 DEPLOY.md 中项目目录外的 runtime.env。
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=note_prompt_app
MYSQL_PASSWORD=replace-with-local-app-password
MYSQL_DATABASE=agent_report

# 仅迁移 CLI / Compose one-shot migration 使用，应用运行时不得使用此账号。
# npm run db:status / db:migrate 会优先读取这组变量。
MYSQL_MIGRATION_USER=note_prompt_migrator
MYSQL_MIGRATION_PASSWORD=replace-with-local-migration-password

# 本地若没有 Redis，必须显式允许仅开发环境的内存降级。
RATE_LIMIT_ALLOW_MEMORY_FALLBACK=true
RATE_LIMIT_KEY_PREFIX=note-prompt-dev
AI_GLOBAL_DAILY_LIMIT=1000
TRUST_PROXY=false
# REDIS_URL=redis://localhost:6379/0

# JWT密钥配置
JWT_SECRET=your-strong-random-secret-key-change-in-production
PROVIDER_KEY_ENCRYPTION_SECRET=your-dedicated-provider-key-encryption-secret-change-in-production
VERIFICATION_CODE_SECRET=your-dedicated-verification-hmac-secret-change-in-production
JWT_EXPIRES_IN=2h
NEXTAUTH_URL=http://localhost:3000

# 权益开关：贡献升级默认关闭；Pro AI 也必须保持有限月额度。
ENABLE_CONTRIBUTION_UPGRADES=false
PRO_AI_MONTHLY_LIMIT=100

NODE_ENV=development

# Next.js配置
NEXT_PUBLIC_ENABLE_PROMPT_OPTIMIZER_V2=false

# 邮件服务配置（用于邮箱验证）
EMAIL_HOST=smtp.qq.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@qq.com
EMAIL_PASS=your_email_password_or_token
EMAIL_FROM=your_email@qq.com
EMAIL_FROM_NAME=Note Prompt

# 邮箱验证开关（true=注册需要邮箱验证，false=注册直接激活）
ENABLE_EMAIL_VERIFICATION=false
