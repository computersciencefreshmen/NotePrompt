[Unit]
Description=Renew Note Prompt TLS certificates
Documentation=https://eff-certbot.readthedocs.io/en/stable/using.html#renewing-certificates
Wants=network-online.target
After=network-online.target docker.service
ConditionPathExists=/etc/letsencrypt/renewal

[Service]
Type=oneshot
ExecStart=/usr/bin/certbot renew --quiet
UMask=0077
Nice=10
IOSchedulingClass=idle
